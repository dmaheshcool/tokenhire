# Copy to .env for local work; set the same keys in your host's dashboard for production.

# --- Server (never exposed to the browser) ---------------------------------
# Leave both blank to fall back to data/store.json, which is fine locally but is
# wiped on every serverless cold start. Set them before any real demo.
# Supabase dashboard -> Project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Client (bundled into the JS, so keep it non-secret) -------------------
# The origin encoded into printed GATE posters. Set this to your live domain so a
# poster printed from a laptop still resolves after deploy. Blank = current origin.
VITE_PUBLIC_URL=
